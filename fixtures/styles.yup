yup 0.0.2 Yupana Straight Line Spreadsheet Format
sheet	row	col	type	cell	format
Styles	*	1	|		columnwidth=28
Styles	*	2	|		columnwidth=14
Styles	1	1	$	Bold	bold=true
Styles	2	1	$	Italic	italic=true
Styles	3	1	$	Bold and italic	bold=true|italic=true
Styles	4	1	$	Underlined	underline=single
Styles	5	1	$	Underlined twice	underline=double
Styles	6	1	$	Accounting underline	underline=singleaccounting
Styles	7	1	$	Accounting underline twice	underline=doubleaccounting
Styles	8	1	$	Blue text	fontcolor=0070C0
Styles	9	1	$	Pale blue fill	fill=DDEBF7
Styles	10	1	$	An input	fontcolor=0000FF
Styles	10	2	#	1234.5	fontcolor=0000FF|fill=FFF2CC|numberformat=#,##0.0
Styles	11	1	$	A total	bold=true
Styles	11	2	=	B10*2	bold=true|underline=doubleaccounting|numberformat=#,##0.0
Styles	12	2	.		fill=DDEBF7
Styles	13	1	$	Not bold nor italic	bold=false|italic=false|fontcolor=000000
Styles	15	1	$	A thin line above	
Styles	15	2	.		bordertop=thin
Styles	17	1	$	A medium line below	
Styles	17	2	.		borderbottom=medium
Styles	19	1	$	A thick line on the left	
Styles	19	2	.		borderleft=thick
Styles	21	1	$	A double line on the right	
Styles	21	2	.		borderright=double
Styles	23	1	$	Dotted above and dashed below	
Styles	23	2	.		bordertop=dotted|borderbottom=dashed
Styles	25	1	$	Red above and blue below	
Styles	25	2	.		bordertop=thin|bordertopcolor=FF0000|borderbottom=double|borderbottomcolor=0070C0
Styles	27	1	$	A total	bold=true|bordertop=thin|borderbottom=double
Styles	27	2	=	B11	bold=true|bordertop=thin|borderbottom=double|numberformat=#,##0.0
Styles	*	3	|		columnwidth=14
Styles	29	1	$	Left	halign=left
Styles	29	2	#	1	halign=left
Styles	30	1	$	Centred	halign=center
Styles	30	2	#	2	halign=center
Styles	31	1	$	Right	halign=right
Styles	32	1	$	Indented from the right	halign=right|indent=2
Styles	33	*	-		rowheight=45
Styles	33	1	$	Top	valign=top
Styles	33	2	$	Middle	valign=center|halign=center
Styles	33	3	$	Bottom	valign=bottom
Styles	34	*	-		rowheight=45
Styles	34	1	$	A long label that wraps onto more lines within its cell	wrap=true|valign=top
Styles	*	*	!		gridlines=false|zoom=85|tabcolor=0070C0|freezerows=1|freezecolumns=1
