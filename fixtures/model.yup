yup 0.0.1 Yupana Straight Line Spreadsheet Format
sheet	row	col	cell	format
Model	1	1	$Year	columnwidth=34
Model	1	2	#2026	columnwidth=10|numberformat=0
Model	1	3	=B1+1	columnwidth=10|numberformat=0
Model	1	4	=C1+1	columnwidth=10|numberformat=0
Model	2	1	$Revenue	
Model	2	2	#1000	numberformat=#,##0.0;(#,##0.0)
Model	3	1	$Growth	indent=1
Model	3	2	#0.08	numberformat=0.0%
Model	3	3	=B3	numberformat=0.0%
Model	3	4	=C3	numberformat=0.0%
Model	2	3	=B2*(1+C3)	numberformat=#,##0.0;(#,##0.0)
Model	2	4	=C2*(1+D3)	numberformat=#,##0.0;(#,##0.0)
Model	4	1	$Costs	
Model	4	2	#-620	numberformat=#,##0.0;(#,##0.0)
Model	4	3	=B4*C2/B2	numberformat=#,##0.0;(#,##0.0)
Model	4	4	=C4*D2/C2	numberformat=#,##0.0;(#,##0.0)
Model	5	1	$Profit	
Model	5	2	=B2+B4	numberformat=#,##0.0;(#,##0.0)
Model	5	3	=C2+C4	numberformat=#,##0.0;(#,##0.0)
Model	5	4	=D2+D4	numberformat=#,##0.0;(#,##0.0)
Model	6	1	$Total profit	indent=1
Model	6	4	=SUM(B5:D5)	numberformat=#,##0.0;(#,##0.0)
Model	7	1	$Worst year	indent=1
Model	7	4	=MIN(B5:D5)	numberformat=#,##0.0;(#,##0.0)
Model	8	1	$Profitable	indent=1
Model	8	4	=D7>0	
