yup 0.0.2 Yupana Straight Line Spreadsheet Format
sheet	row	col	type	cell	format
Functions	1	1	#	3	
Functions	2	1	#	-1.5	
Functions	3	1	#	10	
Functions	4	1	$	ignored text	
Functions	5	1	?	TRUE	
Functions	1	2	=	SUM(A1:A5)	
Functions	2	2	=	MIN(A1:A5)	
Functions	3	2	=	MAX(A1:A5)	
Functions	4	2	=	SUM(A1,A2,100)	
Functions	5	2	=	MIN(A1,A2)	
Functions	6	2	=	MAX(A1,-A3)	
Functions	7	2	=	NA()	
Functions	8	2	=	SUM(A1,B7)	
Functions	9	2	=	MAX(SUM(A1:A3),MIN(A1:A3))	
